CRODIP_HOME=C:/Program Files/CRODIP
CRODIP_DATA_ROOT=C:/ProgramData/CRODIP
CRODIP_USER_ROOT=C:/Users/%USERNAME%/AppData/Local/CRODIP
CRODIP_DEPLOYMENT_MODE=auto
# Images Docker générées depuis config/runtime.json (docker.imageTag)
CRODIP_BACKEND_PORT=8110
CRODIP_FRONTEND_PORT=9110

# Docker provider: desktop | ubuntu
CRODIP_DOCKER_PROVIDER=desktop
CRODIP_WSL_DISTRO=Ubuntu

CRODIP_APPLICATION_VERSION=2.3.0-dev.2
CRODIP_IMAGE_REFERENCE_MODE=digest
