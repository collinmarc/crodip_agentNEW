# CRODIP Runtime CENTRAL - simulation
# Les images backend/frontend sont résolues depuis le pin officiel de config/runtime.json.

CRODIP_BACKEND_PORT=8120
CRODIP_FRONTEND_PORT=9120

CRODIP_CENTRAL_POSTGRES_IMAGE=postgres:17
CRODIP_CENTRAL_POSTGRES_DB=crodip
CRODIP_CENTRAL_POSTGRES_USER=crodip
CRODIP_CENTRAL_POSTGRES_PASSWORD=change-me

CRODIP_APPLICATION_VERSION=2.3.0-dev.2
CRODIP_IMAGE_REFERENCE_MODE=digest
